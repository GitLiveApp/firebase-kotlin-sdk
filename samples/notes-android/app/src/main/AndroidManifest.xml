<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".NotesApplication"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The google_app_id resource that Analytics needs would also let FirebaseInitProvider initialise the default app
             from resources, ahead of NotesFirebase and without the emulator setup; the sample initialises in code instead. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />

        <!-- Android-only: a FirebaseMessagingService is an android.app.Service. KMP: the service stays declared here and
             its class moves to shared/src/androidMain (or stays in the app); see NotesMessagingService. -->
        <service
            android:name=".shared.platform.NotesMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
