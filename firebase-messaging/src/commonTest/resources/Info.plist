<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>dev.gitlive.firebase.messaging.test</string>
	<key>CFBundleName</key>
	<string>firebase-messaging-test</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<!-- The test executable is not an app bundle: UNUserNotificationCenter has no bundle proxy for it, so FIRMessaging
	     must not swizzle the notification delegate (FIRMessagingRemoteNotificationsProxy crashes on start otherwise). -->
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
</dict>
</plist>
